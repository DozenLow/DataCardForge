{
  "comment": "Auto-convert fixtures (units L2b) — read by BOTH backend/tests/units_autoconvert_test.cpp and web/tests/unitsAutoConvert.test.ts, so the C++ engine and the TS reference must agree on every number here. Each case is one table (`columns` = posName + annotation + data) and an expression evaluated under a `policy`. `columnUnits` is the CONVERTIBLE unit carried into the engine for each column — the resolution hierarchy (constant > confirmed > inherited > pre-confirmed > parsed) belongs to the caller in production; pinning it here keeps the case about arithmetic instead of about parsing. Expectation fields: `expectDefault` is the value the engine has always produced (policy absent, and the plain evaluate() call, both checked), `expect` is the value under `policy` ('auto' converts a same-dimension + / - pair of direct column operands, everything else is unchanged), and `conversions` is the COMPLETE ordered list of rewrites (pair index, factor, from/to units) — [] means nothing was touched. The rules the cases pin, verbatim from the task: same dimension converts as value*factorRight/factorLeft (two left-to-right operations, never a precomputed ratio); cross-dimension NEVER converts; strict / free / absent / an unknown policy never convert; nested or non-direct operands never convert.",
  "cases": [
    {
      "name": "same-dim-add-converts-cm-to-m",
      "columns": [
        { "posName": "Pos.1", "annotation": "height_km", "data": [1, 2] },
        { "posName": "Pos.2", "annotation": "height_cm", "data": [150, 200] }
      ],
      "columnUnits": ["m", "cm"],
      "expression": "src.pos.1 + src.pos.2",
      "policy": "auto",
      "expectDefault": [151, 202],
      "expect": [2.5, 4],
      "conversions": [{ "pair": 0, "factor": 0.01, "fromUnit": "cm", "toUnit": "m" }]
    },
    {
      "name": "same-dim-sub-converts-cm-to-m",
      "columns": [
        { "posName": "Pos.1", "annotation": "height_km", "data": [1, 2] },
        { "posName": "Pos.2", "annotation": "height_cm", "data": [150, 200] }
      ],
      "columnUnits": ["m", "cm"],
      "expression": "src.pos.1 - src.pos.2",
      "policy": "auto",
      "expectDefault": [-149, -198],
      "expect": [-0.5, 0],
      "conversions": [{ "pair": 0, "factor": 0.01, "fromUnit": "cm", "toUnit": "m" }]
    },
    {
      "name": "same-dim-sub-converts-pressure-mpa-to-kpa",
      "columns": [
        { "posName": "Pos.1", "annotation": "pressure_kpa", "data": [100, 200, 300] },
        { "posName": "Pos.2", "annotation": "load_mpa", "data": [0.5, 1, 1.25] }
      ],
      "columnUnits": ["kPa", "MPa"],
      "expression": "src.pos.1 - src.pos.2",
      "policy": "auto",
      "expectDefault": [99.5, 199, 298.75],
      "expect": [-400, -800, -950],
      "conversions": [{ "pair": 0, "factor": 1000, "fromUnit": "MPa", "toUnit": "kPa" }]
    },
    {
      "name": "left-to-right-order-pins-the-exact-double",
      "columns": [
        { "posName": "Pos.1", "annotation": "mass_g", "data": [1, 2, 3] },
        { "posName": "Pos.2", "annotation": "mass_kg", "data": [0.001, 0.002, 0.003] }
      ],
      "columnUnits": ["g", "kg"],
      "expression": "src.pos.1 - src.pos.2",
      "policy": "auto",
      "expectDefault": [0.999, 1.998, 2.997],
      "expect": [0, 0, 0],
      "conversions": [{ "pair": 0, "factor": 1000, "fromUnit": "kg", "toUnit": "g" }]
    },
    {
      "name": "cross-dimension-never-converts",
      "columns": [
        { "posName": "Pos.1", "annotation": "load_kpa", "data": [100, 200] },
